NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:REPLACE_LOCAL_ROOT_PASSWORD@127.0.0.1:3306/nexbank
MIGRATION_DATABASE_URL=mysql://root:REPLACE_LOCAL_ROOT_PASSWORD@127.0.0.1:3306/nexbank
JWT_SECRET=replace_with_at_least_32_random_characters
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace_with_a_unique_long_password
SEED_DEMO=true
LAB_ENABLED=true
LAB_DATABASE_URL=mysql://root:REPLACE_LOCAL_ROOT_PASSWORD@127.0.0.1:3306/nexbank_lab
# For verified external TLS connections only; never disable certificate checking.
# DB_SSL_CA=PEM_certificate_contents
# AWS RDS (see docs/AWS_RDS_SETUP.md): path to the downloaded global-bundle.pem
# DB_SSL_CA_FILE=./global-bundle.pem
